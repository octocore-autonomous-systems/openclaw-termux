        print("Patch status: " + ("applied" if not names else "needed: " + ", ".join(names)))
        sys.exit(1 if names else 0)
    if not needed and addon == "applied":
        print("All Android patches already applied. Nothing to do.")
        return

    # Compute every patched text (and build the addon) before writing anything.
    try:
        updates = {}
        for _, path, text, fn in needed:  # several patches may touch one file
            updates[path] = fn(updates.get(path, text))
        stage = build_native() if addon == "needed" else None
    except PatchError as ex:
        fail(str(ex))

    backup_dir = backup_dir_arg or os.path.join(
        os.path.expanduser("~"), ".cache", "openclaw-patch-android", "backups", package_version())
    try:
        if stage:
            install_native(stage, backup_dir)
            print(f"installed {os.path.relpath(native_dir(), dist)}  (relinked musl prebuild + Bionic shim)")
        for path, text in updates.items():
            saved = backup(path, backup_dir)
            atomic_write(path, text)
            print(f"patched   {os.path.relpath(path, dist)}  (original: {saved})")
    except (PatchError, OSError) as ex:
        fail(str(ex))
    print("Patched OK.")


main()
