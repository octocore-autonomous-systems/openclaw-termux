def service_state(text):
    _, end = registry_span(text)
    keys = top_level_keys(text[text.index(REGISTRY_DECL):end])
    has_marker = PATCH_ID in text
    android = keys.count("android")
    if has_marker and android == 1:
        return "applied"
    if has_marker or android:
        raise PatchError(f"partial or foreign android patch (marker={has_marker}, android entries={android})")
    if any(m in text for m in LEGACY_MARKERS):
        raise PatchError("legacy v1 patch present; reinstall the package before patching")
    return "needed"


def patch_service(text):
    if "ignoreServiceWriteResult(" not in text:
        raise PatchError("ignoreServiceWriteResult helper not found")
    if text.count(SERVICE_REGION) != 1:
        raise PatchError("'//#region src/daemon/service.ts' must occur exactly once")
    # Imports: reuse the default fs import, add a collision-resistant spawnSync alias.
    fs_imports = len(FS_IMPORT_RE.findall(text))
    fs_name = "fs" if fs_imports == 1 else "_ocAndroidFs"
    header = ""
    if fs_name != "fs":
        header += 'import _ocAndroidFs from "node:fs";\n'
    if "_ocAndroidSpawnSync" not in text:
        header += SPAWN_IMPORT
    first_region = text.find("\n//#region")
    if first_region < 0:
        raise PatchError("no //#region marker after the import block")
    text = text[: first_region + 1] + header + text[first_region + 1 :]
    # Adapter code goes right after the registry's own helpers, before the registry.
    code = RUNIT_CODE.replace("__PATCH_ID__", PATCH_ID).replace("__FS__", fs_name)
    decl = text.index(REGISTRY_DECL)
    text = text[:decl] + code.lstrip("\n") + text[decl:]
    # Registry entry: append after the last platform entry, before the closing brace.
    start, end = registry_span(text)
    body_end = len(text[:end].rstrip())
    if text[body_end - 1] != "}":
        raise PatchError("registry does not end with a platform entry")
    text = text[:body_end] + ",\n" + ANDROID_ENTRY + "\n" + text[end:]
    if service_state(text) != "applied":
        raise PatchError("post-patch verification failed")
    return text


