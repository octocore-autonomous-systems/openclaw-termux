def atomic_write(path, text):
    base, ext = os.path.splitext(path)
    tmp = f"{os.path.dirname(path)}/.{os.path.basename(base)}.ocpatch-tmp{ext}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    shutil.copymode(path, tmp)
    check = subprocess.run(["node", "--check", tmp], capture_output=True, text=True)
    if check.returncode != 0:
        os.unlink(tmp)
        raise PatchError(f"node --check failed for patched {os.path.basename(path)}:\n{check.stderr.strip()}")
    os.replace(tmp, path)


