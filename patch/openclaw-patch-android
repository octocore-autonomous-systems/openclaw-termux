#!/data/data/com.termux/files/usr/bin/bash
# openclaw-patch-android — inject Termux/runit support into the OpenClaw dist
#
# Content-addressed: walks dist/ (*.js and *.mjs) for stable code anchors, never
# hash-stamped filenames. Each patch (service adapter, dashboard --no-open,
# fs-safe link compatibility) is checked and applied independently, so an
# already-applied service patch never hides a missing dashboard patch.
#
# fs-safe compatibility: Android's app SELinux policy denies link(2) with
# EACCES, which breaks fs-safe's no-replace publication (config reads fail with
# "SQLite read-only worker failed while creating its private snapshot"). The
# patch renames after fs-safe's own target-absent check on Android and adds
# EACCES to the two upstream link-fallback code lists.
#
# fs-safe native: fs-safe ships no Android addon, so its native no-replace
# rename (renameat2) is unavailable and it falls back to link(2). The patcher
# fetches the matching @openclaw/fs-safe-linux-arm64-musl prebuild, relinks it
# for Bionic with patchelf (a small compiled shim supplies __errno_location,
# __xpg_strerror_r, bcmp and musl-numbered sysconf), smoke-tests renameNoReplace,
# installs it next to fs-safe, and maps android/arm64 to that target in every
# copy of the loader. Needs npm, patchelf and clang (pkg install patchelf clang).
#
# proc: getProcessStartTime() reads /proc/<pid>/stat only on "linux"; Android
# has the same /proc, and without it update-run and lock owners have no identity.
#
# migrate: session-SQLite migration archives verified JSONL originals by a
# link-then-unlink two-name publication, which Android cannot do; on Android
# the archive move becomes an exclusive rename with the same identity checks.
#
# birth: SQLite file identity includes birthtime off Linux; Android's
# filesystem reports none (Node substitutes ctime), so every write looked like
# a replaced database ("Existing shared-state database generation changed").
#
# owner: fs-safe trusts temp-root ancestors owned by the user or root; on
# Android /data and /data/data belong to the platform's system uid (1000).
#
# ancestor: temp/SQLite staging ancestors may be group-writable on Android
# (0771 app dirs) when the group is the app's own gid or system; world-writable
# ancestors and private leaf directories are still refused.
#
# lifecycle: `openclaw gateway restart` restarts through runit (sv restart) on
# Android instead of signalling a "foreground" owner it cannot verify.
#
# Fail-closed: an absent or repeated anchor aborts before anything is written.
# Atomic: each file is written to a temporary sibling, syntax-checked with
# `node --check`, and only then renamed over the original.
# Idempotent: a second run reports "already applied" and changes nothing.
# Backup-aware: the pristine file is copied to the backup dir before the first
# mutation (default: ~/.cache/openclaw-patch-android/backups/<version>/).
#
# The runit adapter never rewrites an existing service. stage/install validate
# and preserve $PREFIX/var/service/openclaw-gateway (customized run script with
# HOME, gateway-env.sh and LD_PRELOAD); only a genuinely absent service is
# created, with the same environment behaviour.
#
# Usage:
#   openclaw-patch-android                 # apply missing patches
#   openclaw-patch-android --check         # exit 0 = all applied, 1 = needed, 2 = error
#   openclaw-patch-android --dist PATH     # operate on a staged dist/ tree (testing)
#   openclaw-patch-android --backup-dir D  # override the backup location
#
# Called automatically by openclaw-update after each npm install.
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DIST="${PREFIX}/lib/node_modules/openclaw/dist"
CHECK_ONLY=0
BACKUP_DIR=""

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

while (($#)); do
    case "$1" in
        --check) CHECK_ONLY=1 ;;
        --dist) DIST="${2:?--dist needs a path}"; shift ;;
        --backup-dir) BACKUP_DIR="${2:?--backup-dir needs a path}"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "ERROR: unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

if [[ ! -d "$DIST" ]]; then
    echo "ERROR: OpenClaw dist not found at $DIST" >&2
    exit 2
fi

exec python3 -I - "$DIST" "$CHECK_ONLY" "$BACKUP_DIR" "$PREFIX" << 'PYEOF'
import os, re, shutil, subprocess, sys, json

dist = os.path.realpath(sys.argv[1])
check_only = sys.argv[2] == "1"
backup_dir_arg = sys.argv[3]
prefix = sys.argv[4]

PATCH_ID = "openclaw-patch-android:runit v2"
REGISTRY_DECL = "const GATEWAY_SERVICE_REGISTRY = {"
SERVICE_REGION = "//#region src/daemon/service.ts\n"
DASH_ANCHOR = "if (!options.noOpen) {"
DASH_LINE = 'if (process.env.TERMUX_VERSION || process.platform === "android") options.noOpen = true;'
DASH_DETECT = re.compile(r'TERMUX_VERSION[^\n]*process\.platform === "android"[^\n]*options\.noOpen = true')
SPAWN_IMPORT = 'import { spawnSync as _ocAndroidSpawnSync } from "node:child_process";\n'
# fs-safe publishes no-replace files with link(2), which Android's app SELinux
# policy denies with EACCES (upstream only falls back on EPERM/EXDEV/ENOTSUP).
FSSAFE_ID = "openclaw-patch-android:fs-safe-link v1"
FSSAFE_LINK_RE = re.compile(r"^([ \t]*)fs\.linkSync\(temporaryPath, targetPath\);[ \t]*$", re.M)
FSSAFE_LINK_FALLBACK = (
    "try { fs.linkSync(temporaryPath, targetPath); } catch (_ocAndroidLinkError) {"
    ' if (process.platform !== "android" || !["EACCES", "EPERM"].includes(_ocAndroidLinkError?.code)'
    " || fs.lstatSync(targetPath, { throwIfNoEntry: false })) throw _ocAndroidLinkError;"
    " fs.renameSync(temporaryPath, targetPath); params.onPublished?.(identity); return; }"
    f" /* {FSSAFE_ID} */"
)
FSSAFE_SET_OLD = 'const HARDLINK_FALLBACK_CODES = new Set(["EPERM",'
FSSAFE_SET_NEW = 'const HARDLINK_FALLBACK_CODES = new Set(["EACCES", "EPERM",'
# Native clone (FICLONE) is denied the same way; let it fall back to a plain copy.
FSSAFE_COPY_OLD = 'const NATIVE_COPY_FALLBACK_CODES = new Set(["EINVAL",'
FSSAFE_COPY_NEW = 'const NATIVE_COPY_FALLBACK_CODES = new Set(["EACCES", "EINVAL",'
# The native addon's FICLONE is denied too; retry the native copy without cloning.
FSSAFE_CLONE_ID = "openclaw-patch-android:fs-safe-clone v1"
FSSAFE_CLONE_RE = re.compile(r'^([ \t]*)if \(code === "ENOTSUP" && input\.clone !== "always"\)', re.M)
FSSAFE_CLONE_LINE = ('if (process.platform === "android" && code === "EACCES" && input.clone !== "always"'
                     ' && /FICLONE/.test(String(error?.message))) return await native.copyFileExclusive(input.handle.fd,'
                     ' parentFd, basename, "never", maxBytes !== void 0 && Number.isFinite(maxBytes) ? maxBytes : void 0,'
                     f' nativeSignal); /* {FSSAFE_CLONE_ID} */')
FSSAFE_NORM_RE = re.compile(r'(code === "EOPNOTSUPP" \|\|\s*code === "EPERM")\)')
FSSAFE_NORM_DONE_RE = re.compile(r'code === "EOPNOTSUPP" \|\|\s*code === "EPERM" \|\| code === "EACCES"\)')
FS_IMPORT_RE = re.compile(r'^import fs from "node:fs";$', re.M)
LEGACY_MARKERS = ("_runSv(", "_stageRunitService", "injected by openclaw-patch-android) ──")


class PatchError(Exception):
    pass


def fail(msg):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(2)


# ── discovery ────────────────────────────────────────────────────────────────
def walk_dist():
    for root, dirs, files in os.walk(dist):
        rel = os.path.relpath(root, dist)
        parts = [] if rel == "." else rel.split(os.sep)
        # Extension bundles and nested dependency trees are not the core CLI.
        dirs[:] = [d for d in dirs if d not in ("node_modules", "extensions")]
        if "node_modules" in parts or "extensions" in parts:
            continue
        for name in files:
            if name.endswith((".js", ".mjs")) and ".ocpatch-tmp" not in name:
                path = os.path.join(root, name)
                if os.path.isfile(path) and not os.path.islink(path):
                    yield path


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def discover():
    svc, dash = [], []
    for path in walk_dist():
        try:
            text = read(path)
        except (UnicodeDecodeError, OSError):
            continue
        if REGISTRY_DECL in text:
            svc.append(path)
        if DASH_ANCHOR in text or DASH_DETECT.search(text):
            dash.append(path)
    return svc, dash


def fssafe_roots():
    """Core dist plus the package's own fs-safe copy (bundles inline parts of it)."""
    yield from walk_dist()
    lib = os.path.join(os.path.dirname(dist), "node_modules", "@openclaw", "fs-safe", "dist")
    for root, _dirs, files in os.walk(lib):
        for name in files:
            if name.endswith((".js", ".mjs")) and ".ocpatch-tmp" not in name:
                yield os.path.join(root, name)


def discover_fssafe():
    found = []
    for path in fssafe_roots():
        try:
            text = read(path)
        except (UnicodeDecodeError, OSError):
            continue
        if (FSSAFE_ID in text or FSSAFE_LINK_RE.search(text) or FSSAFE_SET_OLD in text or FSSAFE_COPY_OLD in text
                or FSSAFE_CLONE_ID in text or FSSAFE_CLONE_RE.search(text)
                or FSSAFE_SET_NEW in text or FSSAFE_NORM_RE.search(text) or FSSAFE_NORM_DONE_RE.search(text)):
            found.append(path)
    if not any(FSSAFE_LINK_RE.search(read(p)) or FSSAFE_ID in read(p) for p in found):
        raise PatchError("fs-safe publishCopyStage link anchor not found")
    return found


def fssafe_state(text):
    pending = []
    link = len(FSSAFE_LINK_RE.findall(text))
    if link > 1:
        raise PatchError(f"fs-safe link anchor occurs {link} times")
    if link == 1 and FSSAFE_ID not in text:
        pending.append("link")
    if FSSAFE_SET_OLD in text:
        if text.count(FSSAFE_SET_OLD) != 1:
            raise PatchError("HARDLINK_FALLBACK_CODES occurs more than once")
        pending.append("codes")
    if FSSAFE_COPY_OLD in text:
        if text.count(FSSAFE_COPY_OLD) != 1:
            raise PatchError("NATIVE_COPY_FALLBACK_CODES occurs more than once")
        pending.append("copy-codes")
    clone = len(FSSAFE_CLONE_RE.findall(text))
    if clone > 1:
        raise PatchError(f"native copy ENOTSUP anchor occurs {clone} times")
    if clone == 1 and FSSAFE_CLONE_ID not in text:
        pending.append("clone")
    norm = len(FSSAFE_NORM_RE.findall(text))
    if norm > 1:
        raise PatchError(f"normalizeLinkError anchor occurs {norm} times")
    if norm == 1:
        pending.append("normalize")
    return "needed" if pending else "applied"


def patch_fssafe(text):
    text = FSSAFE_LINK_RE.sub(lambda m: m.group(1) + FSSAFE_LINK_FALLBACK, text, count=1)
    text = text.replace(FSSAFE_SET_OLD, FSSAFE_SET_NEW, 1)
    text = text.replace(FSSAFE_COPY_OLD, FSSAFE_COPY_NEW, 1)
    if FSSAFE_CLONE_ID not in text:
        text = FSSAFE_CLONE_RE.sub(lambda m: m.group(1) + FSSAFE_CLONE_LINE + "\n" + m.group(0), text, count=1)
    text = FSSAFE_NORM_RE.sub(r'\1 || code === "EACCES")', text, count=1)
    if fssafe_state(text) != "applied":
        raise PatchError("fs-safe post-patch verification failed")
    return text


# ── fs-safe native addon (musl prebuild relinked for Bionic) ─────────────────
NATIVE_ID = "openclaw-patch-android:fs-safe-native v1"
NATIVE_PKG = "@openclaw/fs-safe-linux-arm64-musl"
NATIVE_MARKER = ".openclaw-patch-android.json"
LOADER_RE = re.compile(r"\(process\.platform,(\s*)process\.arch,(\s*)isMusl\(\)\)")
LOADER_NEW = ('(process.platform === "android" ? "linux" : process.platform,\\1process.arch,'
              '\\2process.platform === "android" || isMusl()) /* ' + NATIVE_ID + ' */')
SHIM_SOURCE = r"""/* Bionic shims for the linux-arm64-musl fs-safe native addon (openclaw-patch-android). */
#include <errno.h>
#include <string.h>
#include <unistd.h>

int *ocmusl_errno_location(void) { return &errno; }

/* Bionic's strerror_r is the XSI (int) form that musl exports as __xpg_strerror_r. */
int ocmusl_xpg_strerror_r(int err, char *buf, size_t len) { return strerror_r(err, buf, len); }

int ocmusl_bcmp(const void *a, const void *b, size_t n) { return memcmp(a, b, n); }

/* musl and Bionic number the _SC_* names differently; translate musl's numbers. */
long ocmusl_sysconf(int name) {
	switch (name) {
	case 0: return sysconf(_SC_ARG_MAX);
	case 1: return sysconf(_SC_CHILD_MAX);
	case 2: return sysconf(_SC_CLK_TCK);
	case 3: return sysconf(_SC_NGROUPS_MAX);
	case 4: return sysconf(_SC_OPEN_MAX);
	case 30: return sysconf(_SC_PAGESIZE);
	case 69: return sysconf(_SC_GETGR_R_SIZE_MAX);
	case 70: return sysconf(_SC_GETPW_R_SIZE_MAX);
	case 75: return sysconf(_SC_THREAD_STACK_MIN);
	case 83: return sysconf(_SC_NPROCESSORS_CONF);
	case 84: return sysconf(_SC_NPROCESSORS_ONLN);
	case 85: return sysconf(_SC_PHYS_PAGES);
	case 86: return sysconf(_SC_AVPHYS_PAGES);
	default: errno = EINVAL; return -1;
	}
}
"""
SHIM_NAME = "libfs_safe_bionic_shim.so"
WRAPPER_NAME = "android-binding.cjs"
WRAPPER_SOURCE = """"use strict";
// openclaw-patch-android: Android app sandboxes deny FICLONE (and Android filesystems
// cannot reflink), so "auto" cloning means a plain native copy; "always" still fails.
const binding = require("./fs-safe-native.node");
const wrapped = Object.assign({}, binding);
for (const name of ["copyFileExclusive", "copyFileExclusiveSync"]) {
\tif (typeof binding[name] !== "function") continue;
\twrapped[name] = function (sourceFd, parentFd, basename, clone, ...rest) {
\t\treturn binding[name](sourceFd, parentFd, basename, clone === "auto" ? "never" : clone, ...rest);
\t};
}
module.exports = wrapped;
"""
SYMBOL_RENAMES = (
    ("__errno_location", "ocmusl_errno_location"),
    ("__xpg_strerror_r", "ocmusl_xpg_strerror_r"),
    ("bcmp", "ocmusl_bcmp"),
    ("sysconf", "ocmusl_sysconf"),
)
NATIVE_SMOKE = r"""
const fs = require("fs"); const path = require("path");
const b = require(process.argv[1]); const d = process.argv[2];
fs.writeFileSync(path.join(d, "a"), "A"); fs.writeFileSync(path.join(d, "c"), "C");
const fd = fs.openSync(d, "r");
b.renameNoReplace(fd, "a", fd, "b");
if (fs.existsSync(path.join(d, "a")) || fs.readFileSync(path.join(d, "b"), "utf8") !== "A") throw new Error("rename result wrong");
let refused = false;
try { b.renameNoReplace(fd, "c", fd, "b"); } catch (e) { refused = e.code === "EEXIST"; }
if (!refused || fs.readFileSync(path.join(d, "b"), "utf8") !== "A") throw new Error("no-replace not enforced");
if (typeof b.closeOwnedFd !== "function") throw new Error("closeOwnedFd missing");
console.log("ok");
"""


def pkg_root():
    return os.path.dirname(dist)


def fssafe_version():
    try:
        with open(os.path.join(pkg_root(), "node_modules", "@openclaw", "fs-safe", "package.json"), encoding="utf-8") as f:
            return json.load(f)["version"]
    except (OSError, ValueError, KeyError):
        raise PatchError("cannot read the bundled @openclaw/fs-safe version")


def sha256(path):
    import hashlib
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def native_dir():
    return os.path.join(pkg_root(), "node_modules", *NATIVE_PKG.split("/"))


def native_state():
    version = fssafe_version()
    marker = os.path.join(native_dir(), NATIVE_MARKER)
    try:
        with open(marker, encoding="utf-8") as f:
            meta = json.load(f)
        ok = (meta.get("fsSafeVersion") == version
              and sha256(os.path.join(native_dir(), "fs-safe-native.node")) == meta.get("nodeSha256")
              and sha256(os.path.join(native_dir(), SHIM_NAME)) == meta.get("shimSha256")
              and os.path.exists(os.path.join(native_dir(), WRAPPER_NAME))
              and sha256(os.path.join(native_dir(), WRAPPER_NAME)) == meta.get("wrapperSha256")
              and meta.get("wrapperSha256") == __import__("hashlib").sha256(WRAPPER_SOURCE.encode()).hexdigest())
        return "applied" if ok else "needed"
    except (OSError, ValueError):
        return "needed"


def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if r.returncode != 0:
        raise PatchError(f"{' '.join(cmd[:3])} failed: {(r.stderr or r.stdout).strip()[-800:]}")
    return r.stdout


def build_native():
    """Build the relinked addon package in a temporary sibling; return its path."""
    import tarfile, tempfile
    for tool in ("npm", "patchelf", "clang", "node"):
        if not shutil.which(tool):
            raise PatchError(f"{tool} is required to build the fs-safe native addon")
    version = fssafe_version()
    cache = os.path.join(os.path.expanduser("~"), ".cache", "openclaw-patch-android", "native", version)
    os.makedirs(cache, mode=0o700, exist_ok=True)
    tgz = os.path.join(cache, f"openclaw-fs-safe-linux-arm64-musl-{version}.tgz")
    if not os.path.exists(tgz):
        run(["npm", "pack", f"{NATIVE_PKG}@{version}", "--pack-destination", cache, "--silent"])
    parent = os.path.dirname(native_dir())
    os.makedirs(parent, exist_ok=True)
    stage = tempfile.mkdtemp(prefix=".fs-safe-native.ocpatch-tmp-", dir=parent)
    try:
        with tarfile.open(tgz) as tar:
            members = [m for m in tar.getmembers() if m.name.startswith("package/")]
            tar.extractall(stage, members=members, filter="data")
        pkg = os.path.join(stage, "package")
        node_file = os.path.join(pkg, "fs-safe-native.node")
        if not os.path.isfile(node_file):
            raise PatchError("musl prebuild does not contain fs-safe-native.node")
        src = os.path.join(stage, "shim.c")
        with open(src, "w", encoding="utf-8") as f:
            f.write(SHIM_SOURCE)
        run(["clang", "-O2", "-fPIC", "-shared", f"-Wl,-soname,{SHIM_NAME}", "-o", os.path.join(pkg, SHIM_NAME), src])
        renames = os.path.join(stage, "rename.map")
        with open(renames, "w", encoding="utf-8") as f:
            f.write("".join(f"{a} {b}\n" for a, b in SYMBOL_RENAMES))
        run(["patchelf", "--rename-dynamic-symbols", renames, "--add-needed", SHIM_NAME,
             "--set-rpath", "$ORIGIN", node_file])
        smoke = tempfile.mkdtemp(dir=stage)
        out = run(["node", "-e", NATIVE_SMOKE, node_file, smoke])
        if out.strip() != "ok":
            raise PatchError("relinked fs-safe addon failed its smoke test")
        shutil.rmtree(smoke)
        with open(os.path.join(pkg, WRAPPER_NAME), "w", encoding="utf-8") as f:
            f.write(WRAPPER_SOURCE)
        manifest_path = os.path.join(pkg, "package.json")
        with open(manifest_path, encoding="utf-8") as f:
            manifest = json.load(f)
        manifest["main"] = WRAPPER_NAME
        manifest["files"] = sorted(set(manifest.get("files", [])) | {WRAPPER_NAME, SHIM_NAME, NATIVE_MARKER})
        with open(manifest_path, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)
            f.write("\n")
        out = run(["node", "-e", "const b = require(process.argv[1]); if (typeof b.closeOwnedFd !== 'function') process.exit(1); console.log('ok')", pkg])
        if out.strip() != "ok":
            raise PatchError("wrapped fs-safe addon failed to load")
        with open(os.path.join(pkg, NATIVE_MARKER), "w", encoding="utf-8") as f:
            json.dump({"patch": NATIVE_ID, "fsSafeVersion": version,
                       "nodeSha256": sha256(node_file), "shimSha256": sha256(os.path.join(pkg, SHIM_NAME)),
                       "wrapperSha256": sha256(os.path.join(pkg, WRAPPER_NAME))}, f, indent=2)
        return stage
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise


def install_native(stage, backup_dir):
    target = native_dir()
    if os.path.exists(target):
        aside = os.path.join(backup_dir, "replaced-" + os.path.basename(target))
        os.makedirs(backup_dir, mode=0o700, exist_ok=True)
        shutil.rmtree(aside, ignore_errors=True)
        os.replace(target, aside)
    os.replace(os.path.join(stage, "package"), target)
    shutil.rmtree(stage, ignore_errors=True)


def discover_loader():
    found = [p for p in fssafe_roots() if (lambda t: LOADER_RE.search(t) or NATIVE_ID in t)(read(p))]
    if not any("fs-safe" in p for p in found):
        raise PatchError("fs-safe native loader anchor not found")
    return found


def loader_state(text):
    count = len(LOADER_RE.findall(text))
    if count > 1:
        raise PatchError(f"native loader anchor occurs {count} times")
    return "needed" if count == 1 else "applied"


def patch_loader(text):
    text = LOADER_RE.sub(LOADER_NEW, text, count=1)
    if loader_state(text) != "applied" or NATIVE_ID not in text:
        raise PatchError("native loader post-patch verification failed")
    return text


# ── /proc process identity (Android has Linux /proc but platform "android") ──
PROC_RE = re.compile(r'(function getProcessStartTime\((\w+)\)\s*\{\s*if\s*\(!isValidPid\(\2\)\s*\|\|\s*)'
                     r'process\.platform\s*!==\s*(["`])linux\3(\))')
PROC_DONE_RE = re.compile(r'function getProcessStartTime\(\w+\)\s*\{\s*if\s*\(!isValidPid\(\w+\)\s*\|\|\s*'
                          r'\(process\.platform !== "linux" && process\.platform !== "android"\)\)')


def discover_proc():
    found = [p for p in walk_dist() if (lambda t: PROC_RE.search(t) or PROC_DONE_RE.search(t))(read(p))]
    if not found:
        raise PatchError("getProcessStartTime /proc anchor not found")
    return found


def proc_state(text):
    count = len(PROC_RE.findall(text))
    if count > 1:
        raise PatchError(f"getProcessStartTime anchor occurs {count} times")
    return "needed" if count == 1 else "applied"


def patch_proc(text):
    text = PROC_RE.sub(r'\1(process.platform !== "linux" && process.platform !== "android")\4', text, count=1)
    if proc_state(text) != "applied" or not PROC_DONE_RE.search(text):
        raise PatchError("getProcessStartTime post-patch verification failed")
    return text


# ── session-migration archive move (link-required two-name publication) ─────
MOVE_ID = "openclaw-patch-android:migration-move v1"
MOVE_ANCHOR = ("async function moveMigrationArtifact(sourcePath, targetPath, expected, onPublished, publishSourceRemoval) {\n"
               "\tlet createdPublication = false;\n")
MOVE_HELPER = """/** __ID__: Android denies link(2), so archive by exclusive same-directory-tree rename. */
async function _ocAndroidMoveMigrationArtifact(sourcePath, targetPath, expected, onPublished, publishSourceRemoval) {
\tconst sourceStat = fs.lstatSync(sourcePath, { bigint: true, throwIfNoEntry: false });
\tconst targetStat = fs.lstatSync(targetPath, { bigint: true, throwIfNoEntry: false });
\tif (targetStat && sourceStat) throw new Error("artifact publication target already exists");
\tlet moved = Boolean(targetStat);
\tif (!moved && !sameMigrationArtifact(readMigrationArtifactIdentity(sourcePath), expected)) throw new Error("artifact changed before publication");
\tconst removeSource = () => {
