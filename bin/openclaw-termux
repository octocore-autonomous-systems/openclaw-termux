#!/usr/bin/env bash
# openclaw-termux: entry point. Resolves the checkout and runs the Python core in isolated mode,
# so PYTHONPATH, the user site directory and the current directory can never inject modules.
set -euo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(dirname -- "$(dirname -- "$self")")

exec python3 -I -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
from openclaw_termux.cli import main
sys.exit(main(sys.argv[1:]))
' "$root/lib" "$@"
